{
    "name": "Averto — Creative Generation",
    "nodes": [
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "generate-creative",
                "responseMode": "responseNode",
                "options": {}
            },
            "id": "1a2b3c4d-0001-0001-0001-000000000001",
            "name": "Webhook",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 2,
            "position": [
                240,
                300
            ],
            "webhookId": "averto-generate-creative"
        },
        {
            "parameters": {
                "respondWith": "json",
                "responseBody": "={{ JSON.stringify({ ok: true, message: 'Creative generation started' }) }}",
                "options": {}
            },
            "id": "1a2b3c4d-0002-0002-0002-000000000002",
            "name": "Respond to Webhook",
            "type": "n8n-nodes-base.respondToWebhook",
            "typeVersion": 1,
            "position": [
                460,
                160
            ]
        },
        {
            "parameters": {
                "model": "claude-opus-4-5",
                "messages": {
                    "values": [
                        {
                            "role": "user",
                            "content": "You are a Meta Ads creative specialist. Given a campaign and user's creative brief, generate:\n1. A compelling ad headline (max 40 chars)\n2. Ad body copy (max 125 chars)\n3. A detailed image generation prompt for Seedream/Stable Diffusion that will produce a high-quality Meta ad image\n\nCampaign name: {{ $('Webhook').item.json.body.campaign_name }}\nCampaign objective: {{ $('Webhook').item.json.body.campaign_objective }}\nCampaign brief: {{ $('Webhook').item.json.body.campaign_brief }}\nFormat type: {{ $('Webhook').item.json.body.format_type }}\nUser request: {{ $('Webhook').item.json.body.user_prompt }}\n\nRespond ONLY with valid JSON in this exact format, no markdown, no explanation:\n{\n  \"headline\": \"...\",\n  \"body_copy\": \"...\",\n  \"image_prompt\": \"...\"\n}"
                        }
                    ]
                },
                "options": {}
            },
            "id": "1a2b3c4d-0003-0003-0003-000000000003",
            "name": "Claude — Generate Creative",
            "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
            "typeVersion": 1.3,
            "position": [
                460,
                300
            ],
            "credentials": {
                "anthropicApi": {
                    "id": "anthropic-creds",
                    "name": "Anthropic API"
                }
            }
        },
        {
            "parameters": {
                "jsCode": "const raw = $input.first().json.text || $input.first().json.content || '';\nlet parsed;\ntry {\n  // Strip markdown code fences if present\n  const cleaned = raw.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  throw new Error('Claude returned invalid JSON: ' + raw);\n}\nreturn [{\n  json: {\n    headline: parsed.headline,\n    body_copy: parsed.body_copy,\n    image_prompt: parsed.image_prompt,\n    campaign_id: $('Webhook').item.json.body.campaign_id,\n    format_type: $('Webhook').item.json.body.format_type\n  }\n}];"
            },
            "id": "1a2b3c4d-0004-0004-0004-000000000004",
            "name": "Parse Claude Output",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                680,
                300
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "https://api.replicate.com/v1/predictions",
                "authentication": "genericCredentialType",
                "genericAuthType": "httpHeaderAuth",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        }
                    ]
                },
                "sendBody": true,
                "bodyParameters": {
                    "parameters": []
                },
                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify({ version: 'bytedance/seedream-5-lite', input: Object.assign({ prompt: $json.image_prompt, size: '2K', aspect_ratio: $('Webhook').item.json.body.aspect_ratio || '1:1', output_format: 'png' }, $('Webhook').item.json.body.reference_image_url ? { image_input: [$('Webhook').item.json.body.reference_image_url] } : {}) }) }}",
                "options": {}
            },
            "id": "1a2b3c4d-0005-0005-0005-000000000005",
            "name": "Replicate — Start Prediction",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                900,
                300
            ],
            "credentials": {
                "httpHeaderAuth": {
                    "id": "replicate-creds",
                    "name": "Replicate API"
                }
            }
        },
        {
            "parameters": {
                "jsCode": "return [{\n  json: {\n    prediction_id: $input.first().json.id,\n    headline: $('Parse Claude Output').item.json.headline,\n    body_copy: $('Parse Claude Output').item.json.body_copy,\n    campaign_id: $('Parse Claude Output').item.json.campaign_id,\n    format_type: $('Parse Claude Output').item.json.format_type,\n    reference_image_url: $('Webhook').item.json.body.reference_image_url || null\n  }\n}];"
            },
            "id": "1a2b3c4d-0006-0006-0006-000000000006",
            "name": "Store Prediction ID",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1120,
                300
            ]
        },
        {
            "parameters": {
                "amount": 15,
                "unit": "seconds"
            },
            "id": "1a2b3c4d-0007-0007-0007-000000000007",
            "name": "Wait 15s",
            "type": "n8n-nodes-base.wait",
            "typeVersion": 1.1,
            "position": [
                1340,
                300
            ],
            "webhookId": "averto-wait-poll"
        },
        {
            "parameters": {
                "method": "GET",
                "url": "=https://api.replicate.com/v1/predictions/{{ $json.prediction_id }}",
                "authentication": "genericCredentialType",
                "genericAuthType": "httpHeaderAuth",
                "options": {}
            },
            "id": "1a2b3c4d-0008-0008-0008-000000000008",
            "name": "Replicate — Poll Status",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                1560,
                300
            ],
            "credentials": {
                "httpHeaderAuth": {
                    "id": "replicate-creds",
                    "name": "Replicate API"
                }
            }
        },
        {
            "parameters": {
                "conditions": {
                    "options": {
                        "caseSensitive": true,
                        "leftValue": "",
                        "typeValidation": "strict"
                    },
                    "conditions": [
                        {
                            "id": "cond-succeeded",
                            "leftValue": "={{ $json.status }}",
                            "rightValue": "succeeded",
                            "operator": {
                                "type": "string",
                                "operation": "equals"
                            }
                        }
                    ],
                    "combinator": "and"
                },
                "options": {}
            },
            "id": "1a2b3c4d-0009-0009-0009-000000000009",
            "name": "Succeeded?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 2.2,
            "position": [
                1780,
                300
            ]
        },
        {
            "parameters": {
                "conditions": {
                    "options": {
                        "caseSensitive": true,
                        "leftValue": "",
                        "typeValidation": "strict"
                    },
                    "conditions": [
                        {
                            "id": "cond-failed",
                            "leftValue": "={{ $json.status }}",
                            "rightValue": "failed",
                            "operator": {
                                "type": "string",
                                "operation": "equals"
                            }
                        }
                    ],
                    "combinator": "and"
                },
                "options": {}
            },
            "id": "1a2b3c4d-0010-0010-0010-000000000010",
            "name": "Failed?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 2.2,
            "position": [
                1780,
                480
            ]
        },
        {
            "parameters": {
                "jsCode": "const pollData = $input.first().json;\nconst storedData = $('Store Prediction ID').item.json;\n\n// Replicate returns output as array of URLs\nconst imageUrl = Array.isArray(pollData.output) ? pollData.output[0] : pollData.output;\n\nif (!imageUrl) throw new Error('No image URL in Replicate output');\n\nreturn [{\n  json: {\n    campaign_id: storedData.campaign_id,\n    headline: storedData.headline,\n    body_copy: storedData.body_copy,\n    format_type: storedData.format_type,\n    image_url: imageUrl,\n    status: 'pending_approval'\n  }\n}];"
            },
            "id": "1a2b3c4d-0011-0011-0011-000000000011",
            "name": "Extract Image URL",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                2000,
                220
            ]
        },
        {
            "parameters": {
                "operation": "insert",
                "tableId": "creatives",
                "dataToSend": "defineBelow",
                "fieldsUi": {
                    "fieldValues": [
                        {
                            "fieldId": "campaign_id",
                            "fieldValue": "={{ $json.campaign_id }}"
                        },
                        {
                            "fieldId": "headline",
                            "fieldValue": "={{ $json.headline }}"
                        },
                        {
                            "fieldId": "body_copy",
                            "fieldValue": "={{ $json.body_copy }}"
                        },
                        {
                            "fieldId": "format_type",
                            "fieldValue": "={{ $json.format_type }}"
                        },
                        {
                            "fieldId": "image_url",
                            "fieldValue": "={{ $json.image_url }}"
                        },
                        {
                            "fieldId": "status",
                            "fieldValue": "pending_approval"
                        }
                    ]
                }
            },
            "id": "1a2b3c4d-0012-0012-0012-000000000012",
            "name": "Supabase — Insert Creative",
            "type": "n8n-nodes-base.supabase",
            "typeVersion": 1,
            "position": [
                2220,
                220
            ],
            "credentials": {
                "supabaseApi": {
                    "id": "supabase-creds",
                    "name": "Supabase API"
                }
            }
        },
        {
            "parameters": {
                "jsCode": "// Log the error for debugging\nconst pollData = $input.first().json;\nconsole.error('Replicate prediction failed:', JSON.stringify(pollData.error));\nreturn [{ json: { error: pollData.error, status: 'failed' } }];"
            },
            "id": "1a2b3c4d-0013-0013-0013-000000000013",
            "name": "Log Failure",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                2000,
                480
            ]
        }
    ],
